
{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/login",
      "destination": "/api/login"
    },
    {
      "source": "/receiving/delete-draft",
      "destination": "/api/receiving/delete-draft"
    },
    {
      "source": "/accounting/period-lock",
      "destination": "/api/accounting/period-lock"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ]
}
